{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // Ported from `@tanstack/eslint-config` by `npx @oxlint/migrate --with-nursery --type-aware`.
  // Three rules had no oxlint equivalent and are gone: `@typescript-eslint/naming-convention`,
  // `node/prefer-node-protocol`, `no-restricted-syntax` — none of them was carrying a decision of
  // ours. The import-sorting rules were already `off` here.
  "plugins": ["import", "typescript", "react"],

  // The category oxlint enables by default: code that is outright wrong. ESLint gave us none of it,
  // since the shared config never opted into a typed correctness pass.
  "categories": {
    "correctness": "error"
  },

  "env": {
    "builtin": true,
    "es2020": true,
    "browser": true
  },

  // `convex/_generated` is regenerated by the CLI, `.output`, `.vercel` and `dist` are build
  // artefacts: none of them is ours to lint. `.claude/worktrees/` holds whole checkouts of this
  // repository — linting them means linting every file twice over.
  "ignorePatterns": [
    "convex/_generated/",
    ".claude/",
    ".output/",
    ".vercel/",
    "dist/",
    "coverage/"
  ],

  "rules": {
    "for-direction": "error",
    "no-async-promise-executor": "error",
    "no-case-declarations": "error",
    "no-class-assign": "error",
    "no-compare-neg-zero": "error",
    "no-cond-assign": "error",
    "no-constant-binary-expression": "error",
    "no-constant-condition": "error",
    "no-control-regex": "error",
    "no-debugger": "error",
    "no-delete-var": "error",
    "no-dupe-else-if": "error",
    "no-duplicate-case": "error",
    "no-empty-character-class": "error",
    "no-empty-pattern": "error",
    "no-empty-static-block": "error",
    "no-ex-assign": "error",
    "no-extra-boolean-cast": "error",
    "no-fallthrough": "error",
    "no-global-assign": "error",
    "no-invalid-regexp": "error",
    "no-irregular-whitespace": "error",
    "no-loss-of-precision": "error",
    "no-misleading-character-class": "error",
    "no-nonoctal-decimal-escape": "error",
    "no-regex-spaces": "error",
    "no-self-assign": "error",
    "no-shadow": "warn",
    "no-shadow-restricted-names": "error",
    "no-sparse-arrays": "error",
    "no-unsafe-finally": "error",
    "no-unsafe-optional-chaining": "error",
    "no-unused-labels": "error",
    "no-unused-private-class-members": "error",
    "no-useless-backreference": "error",
    "no-useless-catch": "error",
    "no-useless-escape": "error",
    "no-var": "error",
    "no-with": "error",
    "prefer-const": "error",
    "require-yield": "error",
    "use-isnan": "error",
    "valid-typeof": "error",

    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "import/first": "error",
    "import/newline-after-import": "error",
    "import/no-commonjs": "error",
    "import/no-duplicates": "error",

    "typescript/ban-ts-comment": [
      "error",
      { "ts-expect-error": false, "ts-ignore": "allow-with-description" }
    ],
    "typescript/consistent-type-imports": [
      "error",
      { "prefer": "type-imports" }
    ],
    "typescript/method-signature-style": ["error", "property"],
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-inferrable-types": ["error", { "ignoreParameters": true }],
    "typescript/no-misused-new": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-for-of": "warn",
    "typescript/triple-slash-reference": "error",

    // Moved off `tsc`. `noUnusedLocals`/`noUnusedParameters` also police the vendored `.ts` a
    // component's test helper pulls into the program — `@convex-dev/workpool/test` resolves to
    // `src/`, not `dist/`, and its `const _ = {} as X satisfies Y` idiom trips them. The linter
    // never leaves our own files, so the rule lands where it belongs. `_` prefix stays exempt: the
    // codebase already writes `_ctx` and `_unused` for a signature it must honour but not read.
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],

    // Default `.sort()` is lexicographic, which is exactly what a comparison of two arrays of
    // names wants. The rule is aimed at numbers.
    "typescript/require-array-sort-compare": [
      "error",
      { "ignoreStringArrays": true }
    ]
  },

  "overrides": [
    {
      "files": ["src/shared/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react", "react-dom", "react-dom/*", "react/*"],
                "message": "src/shared runs on both sides: a React import makes it browser-only. Move the module to src/lib."
              },
              {
                "group": ["**/_generated/*", "convex/react", "@convex-dev/*"],
                "message": "src/shared is read by the Convex functions themselves: it cannot depend on the generated client. Move the module to src/client."
              },
              {
                "group": ["../lib/*", "../client/*", "../routes/*"],
                "message": "src/shared is the kernel: it is imported by both sides and depends on neither."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["convex/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/src/lib/*", "**/src/client/*", "**/src/routes/*"],
                "message": "A Convex function may only import the kernel: src/shared."
              }
            ]
          }
        ]
      }
    }
  ]
}
