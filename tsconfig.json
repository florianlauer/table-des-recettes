{
  "exclude": ["spike", "spike13"],
  "include": ["**/*.ts", "**/*.tsx", "vite.config.js"],

  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    /* `noUnusedLocals` and `noUnusedParameters` moved to the linter (`no-unused-vars` in oxlint):
       a Convex component's test helper resolves to its `src/`, so those two flags policed vendored
       `.ts` files that `skipLibCheck` does not cover. The linter only ever reads our own files. */
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    /* Indexing an array or a Record out of bounds yields `undefined` at runtime. Without this
       flag the type claims otherwise, and the linter calls "always truthy" guards that are in
       fact necessary. */
    "noUncheckedIndexedAccess": true
  }
}
