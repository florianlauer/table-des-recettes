{
  "name": "socle-et-vitrine",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vp build",
    "preview": "vp preview",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "format": "vp check --fix",
    "check": "vp fmt --check",
    "migrate": "convex run convex/migrations.ts:runAll",
    "migrate:prod": "convex run convex/migrations.ts:runAll --prod",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "ingest": "tsx spike/ingest.ts",
    "rank": "tsx spike/rank-endpoints.ts",
    "walk": "tsx spike/walk.ts",
    "run:spike": "tsx spike/run.ts",
    "correct": "tsx spike/correct.ts",
    "accept": "tsx spike/accept.ts",
    "verify": "tsc --noEmit -p spike/tsconfig.json && vp test run --config spike/vitest.config.ts",
    "ingest13": "tsx spike13/ingest.ts",
    "run13": "tsx spike13/run.ts",
    "review13": "tsx spike13/review.ts",
    "verify13": "tsc -p spike13/tsconfig.json --noEmit && vp test run --config spike13/vitest.config.ts"
  },
  "dependencies": {
    "@convex-dev/aggregate": "^0.2.2",
    "@convex-dev/migrations": "^0.3.6",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/react-query": "^0.1.0",
    "@convex-dev/workpool": "^0.4.9",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "latest",
    "convex": "^1.43.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tanstack/router-cli": "^1.167.41",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "convex-test": "^0.0.55",
    "dotenv": "^17.2.2",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.34.6"
}
